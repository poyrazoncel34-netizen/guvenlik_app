default_platform(:android)

platform :android do
  desc "Build AAB and deploy to Internal Test Track"
  lane :internal do
    repo_root = File.expand_path("../..", __dir__)
    aab_path = File.join(repo_root, "build/app/outputs/bundle/playRelease/app-play-release.aab")

    # Build the AAB. Keep Fastlane from printing the full command because it
    # contains dart-define values supplied by the operator environment.
    Dir.chdir(repo_root) do
      UI.message("Building Play AAB with dart defines redacted.")
      sh(
        "flutter build appbundle --release --flavor play --dart-define=ENV=production --dart-define=REVENUECAT_ANDROID_API_KEY=#{ENV.fetch('REVENUECAT_ANDROID_API_KEY')} --dart-define=ENCRYPTION_KEY=#{ENV.fetch('ENCRYPTION_KEY')}",
        log: false
      )
    end

    # Upload to Play Store
    upload_to_play_store(
      track: 'internal',
      aab: aab_path,
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false
    )
  end

  desc "Promote Internal to Production"
  lane :promote_to_production do
    repo_root = File.expand_path("../..", __dir__)
    aab_path = File.join(repo_root, "build/app/outputs/bundle/playRelease/app-play-release.aab")

    upload_to_play_store(
      track: 'production',
      aab: aab_path,
      track_promote_to: 'production'
    )
  end
end
