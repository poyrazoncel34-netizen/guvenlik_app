default_platform(:android)

# Fastlane is deliberately not a release authority for KoruBeni. These
# identity markers document the canonical artifact without providing an
# executable local build path. The production key is resolved only inside the
# protected release workflow; the text below is not evaluated as Ruby code:
CANONICAL_AAB_PATH = "build/app/outputs/bundle/playRelease/app-play-release.aab"
CANONICAL_BUILD_IDENTITY = %q(--flavor play --target-platform android-arm64 --dart-define=ENV=production ENV.fetch('REVENUECAT_ANDROID_API_KEY'))

def fail_closed_release_lane!(lane_name)
  UI.user_error!(
    "#{lane_name} is disabled: use the canonical tagged GitHub release workflow " \
    "and promote its evidence-bound artifact. Fastlane cannot build or publish " \
    "#{CANONICAL_AAB_PATH}."
  )
end

platform :android do
  desc "Disabled: tagged workflow is the only release authority"
  lane :internal do
    fail_closed_release_lane!("android internal")
  end

  desc "Disabled: evidence-bound promotion is external to Fastlane"
  lane :promote_to_production do
    fail_closed_release_lane!("android promote_to_production")
  end
end
