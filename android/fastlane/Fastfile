default_platform(:android)

# CI-only release policy: use the signed Release Play AAB workflow and its
# verified build/app/outputs/bundle/playRelease/app-play-release.aab evidence.
# These legacy entry points intentionally never build, upload or promote.
platform :android do
  desc "Disabled: use the signed CI artifact and release gates"
  lane :internal do
    UI.user_error!("Local Fastlane upload is disabled. Use Release Play AAB and store/PRODUCTION_ROLLOUT_RUNBOOK.md; do not rebuild an accepted candidate.")
  end

  desc "Disabled: promotion requires the approved CI candidate evidence"
  lane :promote_to_production do
    UI.user_error!("Local Fastlane promotion is disabled. Use the approved CI candidate and store/PRODUCTION_ROLLOUT_RUNBOOK.md.")
  end
end
