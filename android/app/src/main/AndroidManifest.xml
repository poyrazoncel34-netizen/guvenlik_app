<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Location for emergency GPS -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required for Google Play Billing (RevenueCat) -->
    <uses-permission android:name="com.android.vending.BILLING" />
    <!-- Background location removed for store compliance (request only if truly required) -->

    <!-- Offline-first core with optional online map tiles and connectivity checks -->
    <!-- Contact Picker uses Intent.ACTION_PICK — no READ_CONTACTS permission needed -->
    <!-- Notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- RECORD_AUDIO removed — audio recording feature disabled -->
    <!-- Vibration for shake feedback -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Phone state for detecting real calls during fake call (PhoneStateStreamHandler) -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- 
    ⚠️ CRITICAL EMERGENCY PERMISSIONS ⚠️
    Emergency flow:
    1. Opens the user's SMS app with a prefilled emergency message
    2. Makes a direct phone call when the user confirms
    
    ZERO-FAULT GUARANTEE: If SMS composer cannot open, the call flow can still proceed.
    Runtime permissions are checked/requested before each action.
    -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Foreground Service for keeping app alive in background -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- FOREGROUND_SERVICE_MICROPHONE removed — audio recording feature disabled -->
    <!-- Required for BackgroundService (timer/check-in keepalive, specialUse type) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Wake Lock for keeping CPU alive during emergency -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 
    ⚠️ GOOGLE PLAY POLICY WARNING ⚠️
    REQUEST_IGNORE_BATTERY_OPTIMIZATIONS is a RESTRICTED permission.
    Google Play often REJECTS apps using this unless:
    1. The app's core functionality requires background operation (emergency app ✓)
    2. You provide clear justification in the Play Console declaration form
    3. The app prompts users to whitelist it (not automatically)
    
    For KoruBeni: This is justified because the app MUST run in background
    to detect emergency triggers (panic button, shake detection) at all times.
    User lives may depend on this working 24/7.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Screen size compatibility -->
    <supports-screens
        android:smallScreens="true"
        android:normalScreens="true"
        android:largeScreens="true"
        android:xlargeScreens="true"
        android:anyDensity="true"
        android:resizeable="true" />
    
    <application
        android:label="KoruBeni${appLabelSuffix}"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Flutter Background Service — timer/check-in keepalive (specialUse to avoid Android 15 dataSync 6h limit) -->
        <service
            android:name="id.flutter.flutter_background_service.BackgroundService"
            tools:replace="android:exported,android:foregroundServiceType"
            android:foregroundServiceType="specialUse"
            android:exported="false"
            android:enabled="true"
            android:stopWithTask="false"
            android:permission="android.permission.BIND_JOB_SERVICE">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="emergency_checkin_keepalive" />
        </service>
        <service
            android:name=".emergency.ShakeDetectorService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="emergency_shake_monitoring" />
        </service>
        <!-- RecordingSessionService removed — audio recording feature disabled -->
        <receiver
            android:name=".emergency.CheckInAlarmReceiver"
            android:enabled="true"
            android:exported="false" />
        <!-- C4 safety net: fires if Dart timer freezes under Doze mode -->
        <receiver
            android:name=".emergency.CountdownAlarmReceiver"
            android:enabled="true"
            android:exported="false" />
        <receiver
            android:name=".emergency.BootCompletedReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <!-- SMS composer visibility (Android 11+ package visibility) -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="sms" />
        </intent>
    </queries>
</manifest>
