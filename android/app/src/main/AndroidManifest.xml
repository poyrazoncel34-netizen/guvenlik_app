<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Location for emergency GPS -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required for Google Play Billing (RevenueCat) -->
    <uses-permission android:name="com.android.vending.BILLING" />
    <!-- Background location removed for store compliance (request only if truly required) -->

    <!-- Offline-first core with optional online map tiles and connectivity checks -->
    <!-- Contact Picker uses Intent.ACTION_PICK — no READ_CONTACTS permission needed -->
    <uses-permission
        android:name="android.permission.READ_CONTACTS"
        tools:node="remove" />
    <!-- Notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- RECORD_AUDIO removed — audio recording feature disabled -->
    <!-- Vibration for shake feedback -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- CALL_PHONE: direct emergency call (falls back to dialer if permission denied) -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />
    <!-- Foreground Service for keeping app alive in background -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- FOREGROUND_SERVICE_MICROPHONE removed — audio recording feature disabled -->
    <!-- Required for BackgroundService (timer/check-in keepalive, specialUse type) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Wake Lock for keeping CPU alive during emergency -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 
    REQUEST_IGNORE_BATTERY_OPTIMIZATIONS is restricted and must stay tied to
    user-controlled active safety-session reliability. The app must present it
    as optional, must continue in degraded mode if denied, and must keep any
    Play Console declaration/operator evidence outside the repo audit.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Screen size compatibility -->
    <supports-screens
        android:smallScreens="true"
        android:normalScreens="true"
        android:largeScreens="true"
        android:xlargeScreens="true"
        android:anyDensity="true"
        android:resizeable="true" />
    
    <application
        android:label="KoruBeni${appLabelSuffix}"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:usesCleartextTraffic="false"
        android:enableOnBackInvokedCallback="true">
        <!-- Android 16 (API 36), sw>=600dp ekranlarda orientation/resizability
             kisitlarini yok sayar; portre kilidi (main.dart) tablet/katlanabilirde
             devre disi kalirdi. Bu property Google'in belgeledigi GECICI opt-out'tur
             ve API 37 hedeflenince kalkacak — adaptif layout calismasi o zamana
             kadar planlanmali. -->
        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
            android:value="true" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Flutter Background Service — user-started safety timer/session keepalive.
             specialUse is declared because Safe Walk, Check-In, and emergency countdown
             reliability do not fit a single standard foregroundServiceType. -->
        <service
            android:name="id.flutter.flutter_background_service.BackgroundService"
            tools:replace="android:exported,android:foregroundServiceType"
            android:foregroundServiceType="specialUse"
            android:exported="false"
            android:enabled="true"
            android:stopWithTask="false"
            android:permission="android.permission.BIND_JOB_SERVICE">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="emergency_checkin_keepalive" />
        </service>
        <!-- Geolocator's foreground location service is not used in this Play release. -->
        <service
            android:name="com.baseflow.geolocator.GeolocatorLocationService"
            tools:node="remove" />
        <!-- Shake detection is disabled in this release; service kept out of manifest. -->
        <!-- Audio recording service is disabled in this release. -->
        <receiver
            android:name=".emergency.CheckInAlarmReceiver"
            android:enabled="true"
            android:exported="false" />
        <!-- C4 safety net: fires if Dart timer freezes under Doze mode -->
        <receiver
            android:name=".emergency.CountdownAlarmReceiver"
            android:enabled="true"
            android:exported="false" />
        <receiver
            android:name=".emergency.BootCompletedReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>

    </queries>
</manifest>
