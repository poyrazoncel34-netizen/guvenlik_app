<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Location for emergency GPS -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required for Google Play Billing (RevenueCat) -->
    <uses-permission android:name="com.android.vending.BILLING" />
    <!-- Background location removed for store compliance (request only if truly required) -->

    <!-- Offline-first core with optional online map tiles and connectivity checks -->
    <!-- Contact Picker uses Intent.ACTION_PICK — no READ_CONTACTS permission needed -->
    <uses-permission
        android:name="android.permission.READ_CONTACTS"
        tools:node="remove" />
    <!-- Notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- USE_FULL_SCREEN_INTENT deliberately not requested. KoruBeni is neither
         an alarm-clock app nor a phone/VoIP receiving app, and the Play build
         has no separate explicit-consent UX for this special access. Urgent
         safety events use a HIGH-importance heads-up notification instead. -->
    <!-- RECORD_AUDIO removed — audio recording feature disabled -->
    <!-- Vibration for shake feedback -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- CALL_PHONE: user-armed Panic, Check-In, and Safe Walk expiry may submit
         a Telecom call request. Connection is never claimed; denied permission
         is handled as an explicit not-ready/manual-dial outcome. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="true" />
    <!-- Wake Lock for keeping CPU alive during emergency -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 
    REQUEST_IGNORE_BATTERY_OPTIMIZATIONS is restricted and must stay tied to
    user-controlled active safety-session reliability. The app must present it
    as optional, must continue in degraded mode if denied, and must keep any
    Play Console declaration/operator evidence outside the repo audit.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Screen size compatibility -->
    <supports-screens
        android:smallScreens="true"
        android:normalScreens="true"
        android:largeScreens="true"
        android:xlargeScreens="true"
        android:anyDensity="true"
        android:resizeable="true" />
    
    <application
        android:label="KoruBeni${appLabelSuffix}"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:enableOnBackInvokedCallback="true">
        <!-- Android 16 (API 36), sw>=600dp ekranlarda orientation/resizability
             kisitlarini yok sayar; portre kilidi (main.dart) tablet/katlanabilirde
             devre disi kalirdi. Bu property Google'in belgeledigi GECICI opt-out'tur
             ve API 37 hedeflenince kalkacak — adaptif layout calismasi o zamana
             kadar planlanmali. -->
        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
            android:value="true" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity
            android:name=".emergency.EmergencyFallbackDialActivity"
            android:directBootAware="true"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay" />
        <!-- Geolocator's foreground location service is not used in this Play release. -->
        <service
            android:name="com.baseflow.geolocator.GeolocatorLocationService"
            tools:node="remove" />
        <!-- RevenueCat's hybrid manifest contributes this optional Amazon
             proxy even when the store adapter dependency is excluded. Remove
             it from Google Play builds. MissingClass is ignored only on this
             removal marker because the excluded class is intentionally absent. -->
        <activity
            android:name="com.revenuecat.purchases.amazon.purchasing.ProxyAmazonBillingActivity"
            tools:node="remove"
            tools:ignore="MissingClass" />
        <!-- Shake detection is disabled in this release; service kept out of manifest. -->
        <!-- Audio recording service is disabled in this release. -->
        <receiver
            android:name=".emergency.CheckInAlarmReceiver"
            android:enabled="true"
            android:directBootAware="true"
            android:exported="false" />
        <!-- C4 safety net: fires if Dart timer freezes under Doze mode -->
        <receiver
            android:name=".emergency.CountdownAlarmReceiver"
            android:enabled="true"
            android:directBootAware="true"
            android:exported="false" />
        <receiver
            android:name=".emergency.BootCompletedReceiver"
            android:enabled="true"
            android:directBootAware="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.USER_UNLOCKED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".emergency.ExactAlarmPermissionReceiver"
            android:enabled="true"
            android:directBootAware="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".emergency.ClockChangeReceiver"
            android:enabled="true"
            android:directBootAware="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".emergency.EmergencyFallbackCleanupReceiver"
            android:enabled="true"
            android:directBootAware="true"
            android:exported="false" />
        <!-- Quick-access surfaces. Neither arms a session nor dials: both record
             an intent-only request and launch MainActivity, which replays it into
             the single existing arm path (SubscriptionGate -> CountdownScreen ->
             PanicArmPolicy). No new uses-permission is required for either. -->
        <receiver
            android:name=".quickaccess.PanicWidgetProvider"
            android:enabled="true"
            android:exported="false"
            android:label="@string/panic_widget_label">
            <!-- exported="false" is correct for an AppWidgetProvider on API 31+:
                 AppWidgetService delivers APPWIDGET_UPDATE to an explicit
                 component, so the receiver needs no external visibility. -->
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/panic_widget_info" />
        </receiver>
        <!-- The QS tile MUST be exported and MUST be guarded by
             BIND_QUICK_SETTINGS_TILE: SystemUI binds it, and that signature-level
             permission is what restricts the binder to the system. This is the
             one exported component added here, and scripts/audit_android_release_surface.py
             allows it only with exactly that permission and filter. -->
        <service
            android:name=".quickaccess.PanicTileService"
            android:exported="true"
            android:icon="@drawable/ic_panic_tile"
            android:label="@string/panic_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>

    </queries>
</manifest>
